<Window x:Class="Intelbras.CameraCenter.App.Dialogs.AddCameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adicionar dispositivo" Height="690" Width="610"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Dispositivo Intelbras / ONVIF" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Cadastre câmera, DVR, NVR ou Mibo. A senha é criptografada pelo Windows DPAPI."
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,20" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                    <TextBlock Text="Nome" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="NameBox"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="IP / Host" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="HostBox"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Text="Tipo" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="KindBox"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="Usuário" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="UserBox"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Text="Senha / chave de acesso" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PasswordBox"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="Porta RTSP" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="RtspPortBox" Text="554"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,14">
                    <TextBlock Text="Porta HTTP" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="HttpPortBox" Text="80"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,14">
                    <TextBlock Text="Canal" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="ChannelBox" Text="1"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,22,0,14">
                    <CheckBox x:Name="SubStreamCheck" Content="Usar substream" Foreground="{StaticResource TextBrush}"/>
                    <CheckBox x:Name="EventsCheck" Content="Monitorar eventos CGI" Foreground="{StaticResource TextBrush}" IsChecked="True" Margin="0,9,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,0,0,14">
                    <TextBlock Text="RTSP personalizado (opcional)" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                    <TextBox x:Name="CustomRtspBox"/>
                    <TextBlock Text="Vazio usa automaticamente /cam/realmonitor?channel=N&amp;subtype=0/1."
                               Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource GhostButton}" Content="Cancelar" Click="CancelClick" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Salvar dispositivo" Click="SaveClick"/>
        </StackPanel>
    </Grid>
</Window>
