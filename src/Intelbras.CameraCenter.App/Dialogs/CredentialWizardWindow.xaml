<Window x:Class="Intelbras.CameraCenter.App.Dialogs.CredentialWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acesso único" Width="560" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Acesso único ao dispositivo" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock x:Name="DeviceText"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap" Margin="0,7,0,20"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Usuário" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBox x:Name="UsernameBox" Margin="0,5,0,14"/>

                    <TextBlock Text="Senha do equipamento" Foreground="{StaticResource MutedTextBrush}"/>
                    <PasswordBox x:Name="PasswordBox" Margin="0,5,0,14"/>

                    <CheckBox x:Name="SameHostCheck"
                              IsChecked="True"
                              Content="Reutilizar esta credencial em todos os canais deste mesmo DVR/NVR"/>

                    <TextBlock Text="A credencial é protegida pelo Windows DPAPI e não é gravada em texto puro. O aplicativo não tenta senhas padrão, não faz brute force e não contorna autenticação."
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource GhostButton}" Content="Cancelar" Click="CancelClick" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Salvar e validar" Click="SaveClick"/>
        </StackPanel>
    </Grid>
</Window>
