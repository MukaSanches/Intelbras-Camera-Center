<UserControl x:Class="Intelbras.CameraCenter.App.Controls.CameraTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             MinWidth="430" MinHeight="340"
             Unloaded="OnUnloaded">
    <Border Style="{StaticResource CardBorder}" Padding="0" Margin="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="CameraNameText" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="CameraAddressText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#143A2C" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="PRONTO" Foreground="#55E6A5" FontSize="10" FontWeight="Bold"/>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Background="#050709" MinHeight="220">
                <vlc:VideoView x:Name="VideoSurface"/>
                <TextBlock x:Name="IdleText"
                           Text="Clique em Reproduzir"
                           Foreground="#708296"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="13"/>
            </Grid>

            <Grid Grid.Row="2" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StreamText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                <Button Grid.Column="1" x:Name="PlayButton" Style="{StaticResource GhostButton}" Content="▶ Reproduzir" Click="PlayClick" Margin="4,0"/>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="◉ Snapshot" Click="SnapshotClick" Margin="4,0"/>
                <Button Grid.Column="3" x:Name="RecordButton" Style="{StaticResource GhostButton}" Content="● Gravar" Click="RecordClick" Margin="4,0"/>
            </Grid>

            <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PTZ ONVIF • Profile T" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="11"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Content="←" Tag="left" PreviewMouseLeftButtonDown="PtzStart" PreviewMouseLeftButtonUp="PtzStop" Padding="10,5" Margin="2,0"/>
                        <Button Style="{StaticResource GhostButton}" Content="↑" Tag="up" PreviewMouseLeftButtonDown="PtzStart" PreviewMouseLeftButtonUp="PtzStop" Padding="10,5" Margin="2,0"/>
                        <Button Style="{StaticResource GhostButton}" Content="↓" Tag="down" PreviewMouseLeftButtonDown="PtzStart" PreviewMouseLeftButtonUp="PtzStop" Padding="10,5" Margin="2,0"/>
                        <Button Style="{StaticResource GhostButton}" Content="→" Tag="right" PreviewMouseLeftButtonDown="PtzStart" PreviewMouseLeftButtonUp="PtzStop" Padding="10,5" Margin="2,0"/>
                        <Button Style="{StaticResource GhostButton}" Content="−" Tag="zoomout" PreviewMouseLeftButtonDown="PtzStart" PreviewMouseLeftButtonUp="PtzStop" Padding="10,5" Margin="2,0"/>
                        <Button Style="{StaticResource GhostButton}" Content="+" Tag="zoomin" PreviewMouseLeftButtonDown="PtzStart" PreviewMouseLeftButtonUp="PtzStop" Padding="10,5" Margin="2,0"/>
                        <Button Style="{StaticResource GhostButton}" Content="■" Click="PtzStopClick" Padding="10,5" Margin="2,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
